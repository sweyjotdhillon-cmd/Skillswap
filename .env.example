# ==============================================================================
# Skillswap Client Environment Variables (Frontend)
# ==============================================================================
# Supabase project URL (must start with http:// or https://)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase publishable/anon key (Safe for client-side use ONLY WITH RLS ENFORCED)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional fallback if legacy anon key environment variable is used
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# Backend & Supabase Edge Function Environment Variables (SERVER-SIDE ONLY)
# NEVER expose these values in client-side code, frontend builds, or public repositories!
# ==============================================================================
# Supabase URL for Edge Functions
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Service Role Key (CRITICAL: Full database admin access, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Brevo (Sendinblue) API Key for sending password reset emails
BREVO_API_KEY=your-brevo-api-key

# Brevo sender email address
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Allowed Origin for CORS validation in Edge Functions
ALLOWED_ORIGIN=https://skillswap.sweyjotdhillon.workers.dev
