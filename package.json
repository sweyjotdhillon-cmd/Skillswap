{
  "name": "skillswap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:unit": "tsx --test \"src/**/*.test.ts\" --test-name-pattern=\"Unit\"",
    "test:integration": "tsx --test \"src/**/*.test.ts\" --test-name-pattern=\"Integration\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler deploy",
    "security:live": "python3 scripts/security/check.py"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.50.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript-eslint": "8.69.0"
  }
}
